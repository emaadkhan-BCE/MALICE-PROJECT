import time

# 1. This is the magic machine that types out our words
def read_line(sentence):
    for word in sentence:
        print(word, end="", flush=True)
        time.sleep(0.01) # Speed of typing (lower number = faster)
    print() # Moves to a new line when the sentence finishes

